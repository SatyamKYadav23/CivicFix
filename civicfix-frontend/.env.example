# ==========================================================================
# CivicFix Frontend — Environment Configuration
# Copy this file to .env.development.local and set real values.
# ==========================================================================

# Backend API base URL (Spring Boot server)
VITE_API_BASE_URL=http://localhost:8080/api

# Use mock data instead of hitting the real backend (set to false in production)
VITE_USE_MOCK=true

# Application environment label
VITE_APP_ENV=development

